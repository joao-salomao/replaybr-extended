{
  "name": "replaybr-extended",
  "version": "1.0.0",
  "type": "module",
  "description": "Baixa replays do ReplayBR e junta as duas câmeras lado a lado — CLI e aplicação web",
  "bin": {
    "replaybr-extended": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
    "web": "bun run server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./index.ts --compile --minify --bytecode --outfile dist/replaybr-extended"
  },
  "dependencies": {
    "hono": "^4.13.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}

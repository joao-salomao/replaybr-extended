    "hono": "^4.13.2",
    "jszip": "^3.10.1"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ],
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
